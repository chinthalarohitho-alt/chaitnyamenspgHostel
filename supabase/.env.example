# ===================================================================
# EDGE FUNCTION SECRETS  —  server-side only, never reaches the browser
# ===================================================================
# Fill in the values below, then push them to Supabase with:
#
#     npx supabase secrets set --env-file ./supabase/.env
#
# Copy this to supabase/.env and fill it in. That copy is gitignored. Do NOT copy any of these into the root .env
# or give them a VITE_ prefix — Vite inlines every VITE_* variable into
# the public JavaScript bundle that visitors download.
#
# You do NOT need SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY here.
# Supabase injects those into every function automatically, and it
# refuses secrets that start with SUPABASE_.
# ===================================================================


# --- Gmail SMTP (used by: send-invoice) ----------------------------
# The Gmail address invoices are sent FROM.
GMAIL_USER=you@gmail.com

# 16-character App Password — NOT your normal Gmail password.
# Google Account -> Security -> turn on 2-Step Verification
#                -> App passwords -> app "Mail" -> copy the 16 chars
# Spaces are fine; keep the quotes.
GMAIL_APP_PASSWORD=""


# --- CORS (used by: send-invoice, submit-utr) ----------------------
# Which site may call the functions. Use your real domain in
# production; "*" allows any origin and is only sensible while testing.
ALLOWED_ORIGIN=https://chaitanya-mens-pg-hostel.vercel.app
